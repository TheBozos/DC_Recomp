// Native Windows executable icon and version metadata.
#include <winver.h>

1 ICON "dc.ico"
1 24 "dc.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @DC_FILEVERSION@
PRODUCTVERSION @DC_FILEVERSION@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Dark Cloud"
            VALUE "ProductName", "Dark Cloud (DC_Recomp, a native PC port)"
            VALUE "InternalName", "dc"
            VALUE "OriginalFilename", "dc.exe"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
